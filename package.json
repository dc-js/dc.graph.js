{
  "name": "dc.graph",
  "version": "0.9.95",
  "license": "Apache-2.0",
  "copyright": "2015-2023",
  "description": "Graph visualizations integrated with crossfilter and dc.js",
  "main": "dist/dc-graph.js",
  "module": "dist/dc-graph.js",
  "type": "module",
  "keywords": [
    "visualization",
    "svg",
    "animation",
    "graph",
    "network",
    "crossfilter",
    "d3"
  ],
  "homepage": "http://dc-js.github.io/dc.graph.js/",
  "bugs": "https://github.com/dc-js/dc.graph.js/issues",
  "author": {
    "name": "Gordon Woodhull",
    "url": "http://gordon.woodhull.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dc-js/dc.graph.js.git"
  },
  "dependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "crossfilter2": "^1.5.4",
    "d3": "^5.8.0",
    "dagre": "^0.8.5",
    "dc": "4.0.5",
    "ink-docstrap": "^1.3.2",
    "metagraph": "^0.0.7",
    "puppeteer": "^24.31.0",
    "tippy.js": "^6.3.7",
    "viz.js": "^1.8.2",
    "webcola": "^3.4.0",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@eslint/js": "^9.32.0",
    "@fortawesome/fontawesome-free": "^5.14.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "colorbrewer": "^1.0.0",
    "bootstrap": "^3.4.1",
    "classlist-polyfill": "1.2.x",
    "d3-tip": "^0.9.1",
    "d3-force": "^1.2.1",
    "d3-force-straighten-paths": "^1.0.2",
    "dprint": "^0.50.1",
    "eslint": "^9.32.0",
    "glob": "^11.0.3",
    "graphlib-dot": "dagrejs/graphlib-dot#v0.6.4",
    "grunt": "^1.3.0",
    "grunt-cli": "^1.5.0",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-connect": "^5.0.1",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-gh-pages": "^4.0.0",
    "grunt-jsdoc": "^2.4.1",
    "grunt-jsdoc-to-markdown": "^6.0.0",
    "grunt-shell": "^4.0.0",
    "husky": "^9.1.7",
    "ionicons": "^8.0.9",
    "jquery": "^3.5.1",
    "jquery-ui-dist": "^1.13.3",
    "jsdifflib": "^1.1.0",
    "lint-staged": "^16.1.4",
    "load-grunt-tasks": "^5.1.0",
    "prettier": "^3.6.2",
    "promise-polyfill": "^8.1.3",
    "puppeteer-mcp-server": "^0.7.2",
    "rollup": "^4.42.0",
    "rollup-plugin-copy": "^3.5.0",
    "time-grunt": "^1.4.0",
    "uglify-js": "^3.10.3",
    "x-editable": "1.5.x"
  },
  "scripts": {
    "vendor": "cp sync-url-options.js querystring.js chart.registry.js d3.flexdivs.js dc.graph.tracker.domain.js timeline.js web/js/ && cp dc.graph.css web/css/ && cp incrface.mjs web/js/ && cp assets/dynagraph.* web/js/",
    "vendor:thirdparty": "cp node_modules/jquery/dist/jquery.min.js web/js/jquery.js && cp node_modules/jquery-ui-dist/jquery-ui.min.js web/js/jquery-ui.js && cp node_modules/x-editable/dist/bootstrap3-editable/js/bootstrap-editable.min.js web/js/jqueryui-editable.js && cp node_modules/bootstrap/dist/js/bootstrap.min.js web/js/bootstrap.js && cp node_modules/colorbrewer/index.js web/js/colorbrewer.js && cp node_modules/d3-tip/index.js web/js/d3-tip.js",
    "build": "rollup -c && rollup -c worker.rollup.config.js",
    "build:workers": "rollup -c worker.rollup.config.js",
    "build:all": "npm run vendor:thirdparty && npm run vendor && npm run build",
    "prepublishOnly": "npm run build:all",
    "docs:html": "npx jsdoc -c jsdoc.conf.json -r src -d web/docs",
    "docs:md": "npx jsdoc2md \"src/**/*.js\" > web/docs/api.md",
    "docs": "npm run docs:html && npm run docs:md",
    "build:watch": "rollup -c -w & rollup -c worker.rollup.config.js -w",
    "dev": "rollup -c -w & rollup -c worker.rollup.config.js -w",
    "serve": "python3 server.py 8888",
    "start": "(npm run dev &) && npm run serve",
    "lint": "eslint src/ --fix",
    "lint:web": "eslint web/js/{simple-viewer,brushing-filtering,compare-layouts,explore,flexbox,match-game,network-building,random,resizing,shapes-and-text,drag-drop-composition,app_layout,arrow-designer,ceph_layout,qfs_layout,vfc_layout,dynagraph-main,graph-error,sync-url-options,querystring,example-header,dc.graph.tracker.domain,parse-incrface,index,chart.registry,d3.flexdivs,timeline}.js --fix",
    "format": "dprint fmt",
    "format:html": "prettier --write 'web/**/*.html'",
    "format:all": "dprint fmt && npm run format:html",
    "prepare": "husky",
    "legacy:test": "grunt test",
    "legacy:d3v4-force": "rollup -c d3v4-force.rollup.config.js",
    "legacy:interval-tree": "rollup -c lysenko-interval-tree.rollup.config.js",
    "legacy:incrface": "rollup -c incrface.rollup.config.js",
    "debug:console": "node scripts/puppeteer-console.js"
  },
  "npmName": "dc.graph",
  "npmFileMap": [
    {
      "basePath": "/",
      "files": [
        "dc.graph.css",
        "dc.graph.min.js",
        "dc.graph.min.js.map",
        "dc.graph.js",
        "dc.graph.js.map"
      ]
    }
  ],
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "dprint fmt"
    ],
    "*.config.js": [
      "eslint --fix",
      "dprint fmt"
    ],
    "scripts/**/*.js": [
      "eslint --fix",
      "dprint fmt"
    ],
    "web/js/{simple-viewer,brushing-filtering,compare-layouts,explore,flexbox,match-game,network-building,random,resizing,shapes-and-text,drag-drop-composition,app_layout,arrow-designer,ceph_layout,qfs_layout,vfc_layout,dynagraph-main,graph-error,sync-url-options,querystring,example-header,dc.graph.tracker.domain,parse-incrface,index,chart.registry,d3.flexdivs,timeline}.js": [
      "eslint --fix",
      "dprint fmt"
    ],
    "web/**/*.html": [
      "prettier --write"
    ]
  },
  "mcpServers": {
    "puppeteer": {
      "command": "npx",
      "args": [
        "puppeteer-mcp-server"
      ]
    }
  },
  "optionalDependencies": {
    "@dprint/win32-x64": "0.50.1",
    "@dprint/win32-arm64": "0.50.1",
    "@dprint/darwin-x64": "0.50.1",
    "@dprint/darwin-arm64": "0.50.1",
    "@dprint/linux-x64-glibc": "0.50.1",
    "@dprint/linux-x64-musl": "0.50.1",
    "@dprint/linux-arm64-glibc": "0.50.1",
    "@dprint/linux-arm64-musl": "0.50.1",
    "@dprint/linux-riscv64-glibc": "0.50.1"
  }
}
